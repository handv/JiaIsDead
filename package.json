{
  "name": "jia-clan-xhs",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "sync": "rsync -a --delete --exclude='*.test.js' --exclude='todo' --exclude='styles/xhs.css' --exclude='xhs/' ../jia-clan/src/ ./src/ && node scripts/apply-xhs-patches.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/pack.mjs",
    "zip": "npm run sync && npm run build",
    "zip:itch": "node scripts/pack-itch.mjs",
    "zip:cleared": "npm run build:cleared",
    "build:cleared": "npm run sync && node scripts/patch-seed-closed.mjs && vite build && XHS_ZIP_NAME=jia-clan-xhs-tool-cleared.zip node scripts/pack.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2"
  }
}
